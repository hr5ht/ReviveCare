# Copy to .env.local for local development. Production values are set in the Vercel project (Settings → Environment Variables).
# Everything except SECRET_KEY (in production) is optional; features switch off cleanly when their keys are missing.

# --- Core ---
# never True in production
DEBUG=True
# required when DEBUG is off: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# local http only; leave unset in production (cookies are then HTTPS-only)
COOKIE_SECURE=False
# unlocks /setup/ (the clinic's first doctor) on a public site; not needed on localhost. Remove after setup.
SETUP_CODE=
# public address, used for links in emails sent by the scheduled commands
SITE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Database and sign-in (Neon) ---
# required: the Neon Postgres connection string (use a Neon dev branch locally to keep production data safe)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# required: Neon Console → Auth → Configuration → Auth URL, for the same branch as DATABASE_URL
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# Vercel Preview only: a Neon branch and its Auth URL, so previews never touch production
PREVIEW_DATABASE_URL=
PREVIEW_NEON_AUTH_BASE_URL=

# --- Recovery assistant (Groq) ---
# without it the chat answers with a fallback message
GROQ_API_KEY=
# change when Groq retires a model
GROQ_MODEL=openai/gpt-oss-120b

# --- Email (Gmail SMTP by default) ---
# Gmail app password; without it emails print to the console
EMAIL_PASSWORD=
# the sending address (defaults to the project Gmail)
# EMAIL_SENDER=you@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# fallback for alert emails when a patient has no doctor with an email
# DOCTOR_EMAIL=alerts@your-clinic.example

# --- SMS alerts to doctors (Twilio, optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# the Twilio number texts come from
TWILIO_PHONE_NUMBER=
# fallback when the doctor's profile has no phone
TO_NUMBER=

# --- Error monitoring (Sentry, optional) ---
SENTRY_DSN=
# 0 to 1; share of requests traced for performance
SENTRY_TRACES_SAMPLE_RATE=0

# --- HSTS (only once the custom domain serves HTTPS everywhere) ---
# start with 3600, then 31536000
HSTS_SECONDS=0
HSTS_INCLUDE_SUBDOMAINS=True
HSTS_PRELOAD=False
