msgid "Blood pressure (top number)"
msgstr "रक्तचाप (ऊपर वाली संख्या)"

msgid "Blood pressure (bottom number)"
msgstr "रक्तचाप (नीचे वाली संख्या)"

msgid "Heart rate (beats per minute)"
msgstr "हृदय गति (प्रति मिनट धड़कन)"

msgid "Temperature (°F)"
msgstr "तापमान (°F)"

msgid "Enter at least one reading."
msgstr "कम से कम एक रीडिंग दर्ज करें।"

msgid "Enter both blood pressure numbers, e.g. 120 and 80."
msgstr "रक्तचाप की दोनों संख्याएँ दर्ज करें, जैसे 120 और 80।"

