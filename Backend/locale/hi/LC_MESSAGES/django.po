msgstr "कृपया फिर से साइन इन करें।"

msgid "Go to Login"
msgstr "लॉगिन पर जाएँ"

#, python-format
msgid "Welcome back, %(name)s"
msgstr "फिर से स्वागत है, %(name)s"

msgid "Your personalized recovery support dashboard"
msgstr "आपका व्यक्तिगत रिकवरी डैशबोर्ड"

msgid "Exercises"
msgstr "व्यायाम"

msgid ""
"Access your personalized exercise routines designed for your recovery "
"journey. Follow guided videos and track your progress."
msgstr ""
"आपकी रिकवरी के लिए बनाए गए व्यायाम देखें। निर्देशों के साथ व्यायाम करें और अपनी प्रगति देखें।"

msgid "Start Exercises"
msgstr "व्यायाम शुरू करें"

msgid "Chatbot"
msgstr "चैटबॉट"

msgid ""
"Get instant answers to your recovery questions. Our AI assistant is "
"available 24/7 to provide support and guidance."
msgstr ""
"रिकवरी से जुड़े सवालों के तुरंत जवाब पाएँ। हमारा AI सहायक 24/7 मदद के लिए उपलब्ध है।"

msgid "Start Chat"
msgstr "चैट शुरू करें"

msgid "Today's Tasks"
msgstr "आज के काम"

#, python-format
msgid "%(done)s of %(total)s completed"
msgstr "%(total)s में से %(done)s पूरे"

msgid "No exercises assigned yet"
msgstr "अभी कोई व्यायाम तय नहीं किया गया"

msgid "Your doctor will add your plan. Meanwhile you can"
msgstr "आपके डॉक्टर आपकी योजना जोड़ेंगे। तब तक आप"

msgid "browse the exercise library"
msgstr "व्यायाम सूची देख सकते हैं"

msgid "Today's Medicines"
msgstr "आज की दवाइयाँ"

#, python-format
msgid "%(taken)s of %(total)s taken"
msgstr "%(total)s में से %(taken)s ली गईं"

msgid "due"
msgstr "समय हो गया"

msgid "Achievements"
msgstr "उपलब्धियाँ"

#, python-format
