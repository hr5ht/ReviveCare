msgstr "%(total)s में से %(earned)s हासिल"

msgid "Locked"
msgstr "बंद"

msgid "Quick Actions"
msgstr "त्वरित कार्य"

msgid "Start Exercising"
msgstr "व्यायाम करें"

msgid "Chat with AI"
msgstr "AI से बात करें"

msgid "Recovery Summary"
msgstr "रिकवरी सारांश"

msgid "Your goals"
msgstr "आपके लक्ष्य"

msgid "Done"
msgstr "पूरा"

msgid "Due"
msgstr "अंतिम तिथि"

