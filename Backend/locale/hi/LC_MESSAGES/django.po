msgstr "डैशबोर्ड पर वापस"

msgid "Pain diary"
msgstr "दर्द डायरी"

msgid "Note how you feel. Your doctor can see these entries."
msgstr "लिखें कि आप कैसा महसूस कर रहे हैं। आपके डॉक्टर ये प्रविष्टियाँ देख सकते हैं।"

msgid "How bad is your pain right now?"
msgstr "अभी आपका दर्द कितना है?"

msgid "0 = no pain, 10 = worst pain imaginable"
msgstr "0 = कोई दर्द नहीं, 10 = सबसे ज़्यादा दर्द"

msgid "Any of these today?"
msgstr "आज इनमें से कुछ हुआ?"

msgid "Notes"
msgstr "नोट्स"

msgid "Anything else? e.g. pain got worse after climbing stairs"
msgstr "कुछ और? जैसे सीढ़ियाँ चढ़ने के बाद दर्द बढ़ गया"

msgid "Save entry"
msgstr "प्रविष्टि सहेजें"

msgid "Recent entries"
msgstr "हाल की प्रविष्टियाँ"

msgid "No entries yet."
msgstr "अभी तक कोई प्रविष्टि नहीं।"

msgid "Messages"
msgstr "संदेश"

#, python-format
msgid "Write to Dr. %(doctor)s."
msgstr "डॉ. %(doctor)s को लिखें।"

msgid "Write to your care team."
msgstr "अपनी देखभाल टीम को लिखें।"

msgid "For anything urgent, call your doctor or 112."
msgstr "किसी भी आपात स्थिति में अपने डॉक्टर या 112 पर कॉल करें।"

msgid "Seen"
msgstr "देखा गया"

msgid "No messages yet. Ask your doctor anything about your recovery."
msgstr "अभी कोई संदेश नहीं। अपनी रिकवरी के बारे में डॉक्टर से कुछ भी पूछें।"

msgid "Message"
msgstr "संदेश"

msgid "Type your message..."
msgstr "अपना संदेश लिखें..."

msgid "Send"
msgstr "भेजें"

msgid "Notifications"
msgstr "सूचनाएँ"

