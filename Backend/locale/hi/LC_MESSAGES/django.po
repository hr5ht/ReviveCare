msgstr "पूरे हुए लक्ष्य"

msgid "Email preferences saved."
msgstr "ईमेल प्राथमिकताएँ सहेजी गईं।"

msgid "Contact details saved."
msgstr "संपर्क विवरण सहेजा गया।"

